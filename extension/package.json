{
  "name": "ai-ide",
  "displayName": "AI IDE",
  "description": "Task-centric layout for working with CLI AI agents: task tabs with agent status, per-task terminals and files, changes-only explorer across sibling repos.",
  "version": "0.1.0",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aiIde",
          "title": "AI IDE",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "aiIde": [
        {
          "id": "aiIde.changes",
          "name": "Changes"
        },
        {
          "id": "aiIde.tasks",
          "name": "Tasks"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "aiIde.tasks",
        "when": "config.aiIde.titleBarStrip",
        "contents": "A task is an agent with its own terminals and files. Tasks show up as tabs in the title bar.\n[New Task](command:aiIde.newTask)\nCtrl+Alt+N new task · Ctrl+Alt+1…9 switch · Ctrl+Alt+T pick"
      },
      {
        "view": "aiIde.tasks",
        "when": "!config.aiIde.titleBarStrip",
        "contents": "A task is an agent with its own terminals and files. Tasks are listed here and in the status bar; drag them here to reorder.\n[New Task](command:aiIde.newTask)\nCtrl+Alt+N new task · Ctrl+Alt+1…9 switch · Ctrl+Alt+T pick"
      }
    ],
    "commands": [
      {
        "command": "aiIde.newTask",
        "title": "New Task",
        "category": "AI IDE",
        "icon": "$(add)"
      },
      {
        "command": "aiIde.switchTask",
        "title": "Switch Task…",
        "category": "AI IDE"
      },
      {
        "command": "aiIde.activateTask",
        "title": "Open Task",
        "category": "AI IDE"
      },
      {
        "command": "aiIde.renameTask",
        "title": "Rename Task",
        "category": "AI IDE",
        "icon": "$(edit)"
      },
      {
        "command": "aiIde.closeTask",
        "title": "Close Task (stop its terminals)",
        "category": "AI IDE",
        "icon": "$(close)"
      },
      {
        "command": "aiIde.newTerminal",
        "title": "New Terminal in Current Task",
        "category": "AI IDE",
        "icon": "$(terminal)"
      },
      {
        "command": "aiIde.showTerminal",
        "title": "Show Terminal",
        "category": "AI IDE"
      },
      {
        "command": "aiIde.killTerminal",
        "title": "Kill Terminal",
        "category": "AI IDE",
        "icon": "$(trash)"
      },
      {
        "command": "aiIde.toggleMode",
        "title": "Toggle Agent / Classic Layout",
        "category": "AI IDE"
      },
      {
        "command": "aiIde.showExplorer",
        "title": "Show Full Explorer",
        "category": "AI IDE",
        "icon": "$(files)"
      },
      {
        "command": "aiIde.showChanges",
        "title": "Show Changes Only",
        "category": "AI IDE",
        "icon": "$(git-compare)"
      },
      {
        "command": "aiIde.refreshChanges",
        "title": "Refresh Changes",
        "category": "AI IDE",
        "icon": "$(refresh)"
      },
      {
        "command": "aiIde.addRepository",
        "title": "Show Repository in Changes…",
        "category": "AI IDE",
        "icon": "$(repo)"
      },
      {
        "command": "aiIde.openChange",
        "title": "Open Changes",
        "category": "AI IDE"
      },
      {
        "command": "aiIde.openFile",
        "title": "Open File",
        "category": "AI IDE",
        "icon": "$(go-to-file)"
      },
      {
        "command": "aiIde.switchToIndex",
        "title": "Switch to Task by Index",
        "category": "AI IDE"
      },
      {
        "command": "aiIde.armMove",
        "title": "Reorder Tasks (used by the title-bar strip)",
        "category": "AI IDE"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "aiIde.showExplorer",
          "when": "view == aiIde.changes",
          "group": "navigation@1"
        },
        {
          "command": "aiIde.refreshChanges",
          "when": "view == aiIde.changes",
          "group": "navigation@2"
        },
        {
          "command": "aiIde.addRepository",
          "when": "view == aiIde.changes",
          "group": "navigation@3"
        },
        {
          "command": "aiIde.showChanges",
          "when": "view == workbench.explorer.fileView",
          "group": "navigation@0"
        },
        {
          "command": "aiIde.newTask",
          "when": "view == aiIde.tasks",
          "group": "navigation@1"
        },
        {
          "command": "aiIde.newTerminal",
          "when": "view == aiIde.tasks",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "aiIde.openFile",
          "when": "view == aiIde.changes && viewItem == change",
          "group": "inline"
        },
        {
          "command": "aiIde.renameTask",
          "when": "view == aiIde.tasks && viewItem == task",
          "group": "inline@1"
        },
        {
          "command": "aiIde.closeTask",
          "when": "view == aiIde.tasks && viewItem == task",
          "group": "inline@2"
        },
        {
          "command": "aiIde.killTerminal",
          "when": "view == aiIde.tasks && viewItem == terminal",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "aiIde.activateTask",
          "when": "false"
        },
        {
          "command": "aiIde.showTerminal",
          "when": "false"
        },
        {
          "command": "aiIde.killTerminal",
          "when": "false"
        },
        {
          "command": "aiIde.openChange",
          "when": "false"
        },
        {
          "command": "aiIde.openFile",
          "when": "false"
        },
        {
          "command": "aiIde.switchToIndex",
          "when": "false"
        },
        {
          "command": "aiIde.armMove",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      { "command": "aiIde.newTask", "key": "ctrl+alt+n" },
      { "command": "aiIde.switchTask", "key": "ctrl+alt+t" },
      { "command": "aiIde.newTerminal", "key": "ctrl+alt+`" },
      { "command": "aiIde.switchToIndex", "key": "ctrl+alt+1", "args": 0 },
      { "command": "aiIde.switchToIndex", "key": "ctrl+alt+2", "args": 1 },
      { "command": "aiIde.switchToIndex", "key": "ctrl+alt+3", "args": 2 },
      { "command": "aiIde.switchToIndex", "key": "ctrl+alt+4", "args": 3 },
      { "command": "aiIde.switchToIndex", "key": "ctrl+alt+5", "args": 4 },
      { "command": "aiIde.switchToIndex", "key": "ctrl+alt+6", "args": 5 },
      { "command": "aiIde.switchToIndex", "key": "ctrl+alt+7", "args": 6 },
      { "command": "aiIde.switchToIndex", "key": "ctrl+alt+8", "args": 7 },
      { "command": "aiIde.switchToIndex", "key": "ctrl+alt+9", "args": 8 }
    ],
    "configuration": {
      "title": "AI IDE",
      "properties": {
        "aiIde.agentCommand": {
          "type": "string",
          "default": "claude",
          "description": "Command that starts the agent in a new task's first terminal. Leave empty to start a plain shell."
        },
        "aiIde.titleBarStrip": {
          "type": "boolean",
          "default": false,
          "description": "The task strip is injected into the title bar (portable AI IDE install). Set by scripts/install.ps1; leave off in a regular VS Code."
        },
        "aiIde.resumeActiveTaskOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "When the window opens, restart the active task's agent (resuming its Claude Code session)."
        },
        "aiIde.shell": {
          "type": "string",
          "default": "powershell.exe",
          "description": "Shell used for task terminals."
        },
        "aiIde.shellArgs": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["-NoLogo"],
          "description": "Arguments passed to the shell."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "npm run typecheck && npm run build && vsce package --no-dependencies --allow-missing-repository --skip-license -o ai-ide.vsix"
  },
  "dependencies": {
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/headless": "^5.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
